{
	"custom/distro": {
		"format": "󰣇",
		"on-click": "files=($(find /mnt/Volume/Pictures/Wallpaper/diinki -maxdepth 1 -type f \\( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \\) | sort)); i=$(cat /tmp/awww-index 2>/dev/null || echo -1); i=$(( (i + 1) % ${#files[@]} )); echo $i > /tmp/awww-index; awww img \"${files[$i]}\" --transition-type any --transition-duration 3.5 --transition-fps 60",
		"tooltip": false
	}
}
